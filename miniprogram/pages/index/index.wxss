.page {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 100vh;
  padding: 120rpx 64rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.content {
  margin-top: 32rpx;
  color: #5c6470;
  font-size: 30rpx;
  line-height: 1.8;
  text-align: justify;
}
